{
  "name": "snippet-dashboard",
  "version": "1.0.0",
  "description": "A multi-user, self-hosted code snippet manager.",
  "main": "server.js",
  "scripts": {
    "start": "npm run build:css && node server.js",
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./public/css/app.css --minify",
    "watch:css": "tailwindcss -i ./src/tailwind.css -o ./public/css/app.css --watch",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-sqlite3": "^0.9.18",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "ejs": "^7.0.2",
    "express": "^5.2.1",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "short-unique-id": "^5.3.2",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  },
  "overrides": {
    "connect-sqlite3": {
      "sqlite3": "$sqlite3"
    }
  }
}
