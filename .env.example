# The port the application will run on.
PORT=3000

# Initial Admin User Credentials (IMPORTANT!)
# These variables are used ONLY ONCE during the very first startup of the application.
ADMIN_USERNAME=adminuser
ADMIN_PASSWORD=adminpass
ADMIN_EMAIL=admin@example.com

# A long, random, and cryptographically secure string used to sign the session ID cookie.
SESSION_SECRET=a_very_secret_key_for_your_session_please_change_this_seriously

# Rate Limiting for the login page to prevent brute-force attacks.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=10

# The number of snippets to display per page
ITEMS_PER_PAGE=5

# The main title displayed on the homepage.
HOMEPAGE_TITLE="All Snippets"
# The subtitle text displayed on the homepage.
HOMEPAGE_SUBTITLE="A collection of code, notes, and solutions."

# Determines the URL structure for snippet detail pages.
# - 'seo': For human-readable slugs (e.g., /my-awesome-snippet).
# - 'shortid': For compact, unique short IDs (e.g., /Ua3xZ8fE).
URL_STYLE=seo

# How public listings render snippets.
#   cards - roomy, description-led, about six per screen
#   rows  - dense, about twenty per screen, with a date column
# An unrecognised value falls back to 'cards'.
LIST_STYLE=cards

# How many snippets each block beneath a snippet lists.
#   RELATED_COUNT - others in the same category; the block is hidden when the
#                   snippet has no category, or is the only one in it
#   RANDOM_COUNT  - a shuffled handful from anywhere in the library
# Both default to 5 and are capped at 25.
RELATED_COUNT=5
RANDOM_COUNT=5

# How many entries the "Recently added" sidebar card lists.
# Defaults to 5, capped at 25.
RECENT_COUNT=5

# Sidebar cards that can be turned off. Each skips its query as well as its
# markup, so hiding a card costs nothing. Both default to true.
#   SHOW_TAG_CLOUD - lists every tag in the library, which is a very long card
#                    once there are a few hundred of them
#   SHOW_LANGUAGES - lists every language that has at least one snippet
SHOW_TAG_CLOUD=true
SHOW_LANGUAGES=true
