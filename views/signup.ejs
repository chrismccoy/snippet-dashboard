<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create account · SnippetDash</title>
    <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css" />
    <link href="/css/app.css" rel="stylesheet" />
  </head>
  <body class="h-full bg-slate-100 text-slate-800">
    <header class="border-b border-slate-200 bg-white/80 backdrop-blur-sm">
      <div class="mx-auto flex h-14 max-w-[1120px] items-center gap-3 px-5">
        <a href="/" class="flex items-center gap-2.5 text-[15px] font-semibold tracking-tight text-slate-900">
          <span class="grid h-[26px] w-[26px] place-items-center rounded-lg bg-gradient-to-br from-brand-500 to-brand-700 text-xs text-white">
            <%- include('partials/icon', { name: 'fa-solid fa-terminal' }) %>
          </span>
          SnippetDash
        </a>
      </div>
    </header>

    <main class="mx-auto max-w-[1120px] px-5 py-7 pb-14">
      <div class="pub-centre">
        <form action="/signup" method="POST" class="panel">
          <div class="panel-head">
            <h1 class="text-lg font-semibold tracking-tight text-slate-900">Create account</h1>
            <p class="mt-1 text-[13px] text-slate-500">Your account needs admin approval before you can log in.</p>
          </div>

          <% if (error) { %>
            <div class="notice notice-error">
              <%- include('partials/icon', { name: 'fa-solid fa-circle-exclamation' }) %>
              <span><%= error %></span>
            </div>
          <% } %>
          <% if (success) { %>
            <div class="notice notice-ok">
              <%- include('partials/icon', { name: 'fa-solid fa-circle-check' }) %>
              <span><%= success %></span>
            </div>
          <% } %>

          <div class="mb-4">
            <label for="username" class="field-label">Username</label>
            <input type="text" id="username" name="username" required class="input" />
          </div>

          <div class="mb-4">
            <label for="email" class="field-label">Email</label>
            <input type="email" id="email" name="email" required class="input" />
          </div>

          <div class="mb-5">
            <label for="password" class="field-label">Password</label>
            <input type="password" id="password" name="password" required class="input" />
          </div>

          <button type="submit" class="btn btn-primary w-full">Sign up</button>

          <p class="mt-4 text-center text-[13px] text-slate-500">
            <a href="/login" class="text-brand-600 hover:underline">Already have an account? Log in.</a>
          </p>
        </form>
      </div>
    </main>

    <footer class="mx-auto flex max-w-[1120px] items-center justify-center gap-2 px-5 pb-10 text-[11.5px] text-slate-400">
      &copy; <%= new Date().getFullYear() %> SnippetDash
    </footer>

    <script src="/js/app.js"></script>
  </body>
</html>
