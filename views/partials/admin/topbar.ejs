<header class="sticky top-0 z-10 flex h-16 items-center gap-3 border-b border-slate-200 bg-white/80 px-4 backdrop-blur sm:px-6">
  <span class="flex-1"></span>

  <a href="/admin/snippets/new" class="btn btn-primary">
    <%- include('../icon', { name: 'fa-solid fa-plus' }) %> New snippet
  </a>

  <a href="/admin/profile" aria-label="Profile" class="grid h-8 w-8 place-items-center rounded-lg text-slate-500 hover:bg-slate-100 hover:text-slate-700">
    <%- include('../icon', { name: 'fa-solid fa-gear' }) %>
  </a>

  <span class="flex items-center gap-2 rounded-full border border-slate-200 bg-white py-1 pl-1 pr-2.5 text-sm text-slate-600">
    <span class="grid h-6 w-6 place-items-center rounded-full bg-brand-600 text-[11px] font-semibold text-white"><%= session.user.username.slice(0, 1).toUpperCase() %></span>
    <%= session.user.username %>
  </span>
</header>

<nav class="flex flex-nowrap items-center gap-1 overflow-x-auto whitespace-nowrap border-b border-slate-200 bg-white px-4 py-2 text-sm lg:hidden">
  <a href="/admin/snippets" class="rounded px-2 py-1 <%= activeNav === 'snippets' ? 'font-medium text-brand-600' : 'text-slate-500' %>">Snippets</a>
  <% if (session.user.is_admin) { %>
    <a href="/admin/categories" class="rounded px-2 py-1 <%= activeNav === 'categories' ? 'font-medium text-brand-600' : 'text-slate-500' %>">Categories</a>
    <a href="/admin/languages" class="rounded px-2 py-1 <%= activeNav === 'languages' ? 'font-medium text-brand-600' : 'text-slate-500' %>">Languages</a>
  <% } %>
  <a href="/admin/profile" class="rounded px-2 py-1 <%= activeNav === 'profile' ? 'font-medium text-brand-600' : 'text-slate-500' %>">Profile</a>
  <% if (session.user.is_admin) { %>
    <a href="/admin/users/create" class="rounded px-2 py-1 <%= activeNav === 'create-user' ? 'font-medium text-brand-600' : 'text-slate-500' %>">Create User</a>
    <a href="/admin/users" class="rounded px-2 py-1 <%= activeNav === 'users' ? 'font-medium text-brand-600' : 'text-slate-500' %>">Users</a>
  <% } %>
  <a href="/admin/logout" class="rounded px-2 py-1 text-slate-500">Log out</a>
</nav>
