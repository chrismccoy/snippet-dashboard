<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> · Code Snippets</title>
    <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css" />
    <link href="/css/app.css" rel="stylesheet" />
  </head>
  <body class="h-full bg-slate-100 text-slate-800">
    <header class="pub-header-sticky print-hidden">
      <div class="mx-auto flex h-14 max-w-[1120px] items-center gap-3 px-5">
        <a href="/" class="flex items-center gap-2.5 text-[15px] font-semibold tracking-tight text-slate-900">
          <span class="grid h-[26px] w-[26px] place-items-center rounded-lg bg-gradient-to-br from-brand-500 to-brand-700 text-xs text-white">
            <%- include('../icon', { name: 'fa-solid fa-terminal' }) %>
          </span>
          Code Snippets
        </a>
        <span class="flex-1"></span>
        <% if (locals.session && session.user) { %>
          <span class="owner-only">
            <%- include('../icon', { name: 'fa-solid fa-eye' }) %> You are signed in
          </span>
          <a href="/admin/snippets" class="btn btn-quiet btn-sm">
            <%- include('../icon', { name: 'fa-solid fa-gauge-high' }) %> Dashboard
          </a>
        <% } else { %>
          <a href="/admin/login" class="btn btn-quiet btn-sm">Sign in</a>
        <% } %>
      </div>
    </header>

    <main class="pub-main">
      <div class="grid grid-cols-1 gap-7 lg:grid-cols-3 lg:gap-9">
        <div class="lg:col-span-2">
